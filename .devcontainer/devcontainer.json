{
  "name": "AIE2026",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    // 第3回の Pi デモ・発展課題用
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "PYDANTIC_AI_NO_BANNER": "1",
    "UV_LINK_MODE": "copy"
  },
  // Codespaces 作成時に登録を促すシークレット
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Google AI Studio で発行した Gemini API キー",
      "documentationUrl": "https://aistudio.google.com/apikey"
    },
    // Claude Code のスキル・メモリ同期用（任意。未設定なら同期をスキップ）
    "CLAUDE_DATA_REPO": {
      "description": "（任意）スキル・メモリ保存用 private リポジトリ。owner/repo 形式"
    },
    "CLAUDE_DATA_TOKEN": {
      "description": "（任意）上記リポジトリ限定の fine-grained PAT（Contents: Read and write）"
    }
  },
  "postCreateCommand": "bash .devcontainer/persist-claude.sh && pipx install uv && uv sync --frozen",
  // 起動のたびに private リポジトリから pull してリンクする
  "postStartCommand": "bash .devcontainer/claude-data.sh setup",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "GitHub.copilot-chat", "anthropic.claude-code"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "[markdown]": {
          "editor.tabSize": 2
        }
      }
    }
  }
}